{
  "project": "rusty-underworld",
  "serve": {
    "command": "PATH=\"$HOME/.local/bin:$HOME/.dotnet:$PATH\" exec rusty dev --project ./src/AbyssRpg.Host/AbyssRpg.Host.csproj --live-debug --bind-host {host} --port {port} --diagnostics-log {session_dir}/rusty-engine-diagnostics.ndjson",
    "preferredPort": 4177,
    "healthUrl": "/product-ui/main.js",
    "readyText": "mountProductUi",
    "reusePolicy": "broker_owned",
    "startupTimeout": "180s",
    "healthInterval": "250ms"
  }
}
