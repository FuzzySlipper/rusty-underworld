<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>AbyssRpg.Host.AbyssProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>abyssrpg.product</RustyEngineProductId>
    <RustyEngineProductTitle>AbyssRpg: The Stygian Abyss</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui/generated'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>abyss.hud</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>abyss.ui.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineWatchPaths>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineProductInputCursorMode>pointer-lock</RustyEngineProductInputCursorMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="$(RustyEnginePackageVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AbyssRpg.Kit/AbyssRpg.Kit.csproj" />
    <ProjectReference Include="../AbyssRpg.Rulesets.UltimaUnderworld/AbyssRpg.Rulesets.UltimaUnderworld.csproj" />
  </ItemGroup>

  <!--
    Direct intents the browser shell may claim, and the physical mappings that
    deliver the same intents from the keyboard. The names must match
    AbyssProductEntry.LifecycleIntents/ActionIntents and the intent handling in
    AbyssProduct: the staged manifest is what the shell receives, so an intent
    absent here is one the DOM cannot send.
  -->
  <ItemGroup>
    <RustyEngineProductInputIntent Include="abyss.lifecycle.start" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.lifecycle.pause" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.lifecycle.resume" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.lifecycle.stop" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.quicksave" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.journey-onward" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot:" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.respawn" Value="digital" />
    <RustyEngineProductInputMapping Include="abyss.action.quicksave.chord" Intent="abyss.action.quicksave" Trigger="key:key-s:pressed:chord=alt-left" />
    <RustyEngineProductInputMapping Include="abyss.action.journey-onward.chord" Intent="abyss.action.journey-onward" Trigger="key:key-l:pressed:chord=alt-left" />
  </ItemGroup>

  <Target Name="BuildAbyssProductUi" BeforeTargets="GenerateRustyEngineProductComposition">
    <Delete Files="$(RustyEngineProductUiRoot)/main.js.map;$(RustyEngineProductUiRoot)/main.d.ts" />
    <Exec Command="npm --prefix &quot;$(MSBuildThisFileDirectory)../..&quot; exec -- tsc -p &quot;$(MSBuildThisFileDirectory)../ui&quot;" />
  </Target>
</Project>
