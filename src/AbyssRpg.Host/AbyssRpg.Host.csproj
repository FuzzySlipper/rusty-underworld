<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>AbyssRpg.Host.AbyssProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>abyssrpg.product</RustyEngineProductId>
    <RustyEngineProductTitle>AbyssRpg: The Stygian Abyss</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui/generated'))</RustyEngineProductUiRoot>
    <!-- The DOM companion is compiled TypeScript, typed against the pair's own
         UI declarations. The SDK runs this command only when a UI input is
         newer than its last build, and `rusty dev` reloads the UI alone when
         only UI sources change. -->
    <RustyEngineProductUiSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'))</RustyEngineProductUiSourceRoot>
    <RustyEngineProductUiBuildCommand>node &quot;$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../scripts/build-ui.mjs'))&quot; &quot;$(RustyEngineProductUiTypes)&quot;</RustyEngineProductUiBuildCommand>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>abyss.hud</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>abyss.ui.snapshot.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductDefaultWorldLights>disabled</RustyEngineProductDefaultWorldLights>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineProductInputCursorMode>pointer-lock</RustyEngineProductInputCursorMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AbyssRpg.Kit/AbyssRpg.Kit.csproj" />
    <ProjectReference Include="../AbyssRpg.Rulesets.UltimaUnderworld/AbyssRpg.Rulesets.UltimaUnderworld.csproj" />
  </ItemGroup>

  <!--
    Direct intents the browser shell may claim, and the physical mappings that
    deliver the same intents from the keyboard. The names must match
    AbyssProductEntry.LifecycleIntents/ActionIntents and the intent handling in
    AbyssProduct: the staged manifest is what the shell receives, so an intent
    absent here is one the DOM cannot send.
  -->
  <ItemGroup>
    <RustyEngineProductInputIntent Include="abyss.lifecycle.start" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.lifecycle.pause" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.lifecycle.resume" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.lifecycle.stop" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.quicksave" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.journey-onward" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-1" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-2" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-3" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-4" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-5" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-6" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-7" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-8" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-9" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-10" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-11" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-12" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.load-slot-13" Value="digital" />
    <RustyEngineProductInputIntent Include="abyss.action.respawn" Value="digital" />
    <RustyEngineProductInputMapping Include="abyss.lifecycle.pause.escape" Intent="abyss.lifecycle.pause" Trigger="key:escape:pressed" />
    <RustyEngineProductInputMapping Include="abyss.action.quicksave.chord" Intent="abyss.action.quicksave" Trigger="key:key-s:pressed:chord=alt-left" />
    <RustyEngineProductInputMapping Include="abyss.action.journey-onward.chord" Intent="abyss.action.journey-onward" Trigger="key:key-l:pressed:chord=alt-left" />
  </ItemGroup>

  <!-- UI build inputs outside the UI source root: the compiler and its
       lockfile, the build script, and the pair's UI declarations, so a pair
       move rebuilds the UI. -->
  <ItemGroup>
    <RustyEngineProductUiInput Include="$(MSBuildThisFileDirectory)../../package.json;$(MSBuildThisFileDirectory)../../package-lock.json;$(MSBuildThisFileDirectory)../../scripts/build-ui.mjs;$(RustyEngineProductUiTypes)" />
  </ItemGroup>
</Project>
